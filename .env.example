# Google AI Studio / Gemini API key (required for LLM extraction and semantic verdicts)
GEMINI_API_KEY=your_key_here

# Optional - default is Gemini 2.0 Flash
# GEMINI_MODEL=gemini-2.0-flash

# Optional retry/rate controls for Gemini API reliability
# GEMINI_MAX_RETRIES=4
# GEMINI_BACKOFF_INITIAL_S=1.0
# GEMINI_BACKOFF_MAX_S=20.0
# GEMINI_MIN_INTERVAL_S=0.35
